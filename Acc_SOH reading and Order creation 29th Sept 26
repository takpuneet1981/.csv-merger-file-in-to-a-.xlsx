"""
IO layer: loads SOH (zipped/csv region files) and Input-2..6, all located
directly inside INPUT_DIR by matching the start of each filename -- no
subfolder, no exact-filename dependency (tolerant of the daily date suffix
on SOH files, and minor trailing-text differences on Input-2..6).
"""



def _log(lines, msg):
    lines.append(msg)
    print(msg)


def _find_by_prefix(input_dir, prefix, log, label, allow_multiple_soh=False):
    """Finds file(s) in input_dir whose name starts with `prefix`
    (case-insensitive). Returns a list of matching paths."""
    all_files = [f for f in glob.glob(os.path.join(input_dir, "*")) if os.path.isfile(f)]
    matches = [f for f in all_files if os.path.basename(f).lower().startswith(prefix.lower())]
    if not matches:
        raise FileNotFoundError(
            f"No file found in {input_dir} starting with '{prefix}' (expected the {label} file). "
            f"Files present: {[os.path.basename(f) for f in all_files]}"
        )
    if len(matches) > 1 and not allow_multiple_soh:
        _log(log, f"   WARNING: multiple files match '{prefix}*' for {label} "
                   f"({[os.path.basename(m) for m in matches]}) — using the first one alphabetically: "
                   f"{os.path.basename(sorted(matches)[0])}")
        return [sorted(matches)[0]]
    return matches


def load_soh(input_dir, log):
    """Finds every file starting with 'SOH' directly in input_dir, extracts
    zips (regardless of their extension) to a temp dir, and concatenates
    every CSV found."""
    soh_files = _find_by_prefix(input_dir, SOH_FILE_PREFIX, log, "SOH", allow_multiple_soh=True)
    _log(log, f"STEP 1a: Found {len(soh_files)} file(s) starting with 'SOH' in {input_dir}")

    csv_paths = []
    tmpdir = tempfile.mkdtemp(prefix="soh_extract_")

    for f in soh_files:
        if f.lower().endswith(".csv"):
            csv_paths.append(f)
        else:
            try:
                with zipfile.ZipFile(f) as z:
                    z.extractall(tmpdir)
                    for name in z.namelist():
                        if name.lower().endswith(".csv"):
                            csv_paths.append(os.path.join(tmpdir, name))
                _log(log, f"   Extracted {os.path.basename(f)}")
            except zipfile.BadZipFile:
                _log(log, f"   WARNING: {os.path.basename(f)} is neither .csv nor a valid zip — skipped")

    if not csv_paths:
        raise FileNotFoundError(f"No readable CSV files found among SOH files in {input_dir}")

    _log(log, f"STEP 1b: Reading {len(csv_paths)} CSV file(s)...")
    required_cols = list(SOH_COLS.values())
    optional_cols = list(OPTIONAL_SOH_COLS.values())
    needed_cols = required_cols + optional_cols
    frames = []
    for p in csv_paths:
        d = pd.read_csv(p, usecols=lambda c: c in needed_cols, low_memory=False)
        frames.append(d)
        _log(log, f"   {os.path.basename(p)}: {d.shape[0]:,} rows")

    df = pd.concat(frames, ignore_index=True)
    _log(log, f"STEP 1c: Combined SOH shape = {df.shape[0]:,} rows x {df.shape[1]} cols")

    missing_cols = [c for c in required_cols if c not in df.columns]
    if missing_cols:
        raise ValueError(f"SOH files are missing expected columns: {missing_cols}")
    for oc in optional_cols:
        if oc not in df.columns:
            _log(log, f"   WARNING: optional SOH column '{oc}' not found -- the related report field will be blank")
            df[oc] = ""

    return df


