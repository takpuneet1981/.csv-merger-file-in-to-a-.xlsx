def pack_multiplier(pack_qty):
    """PACK_QTY = 0 must be treated as multiplier 1, never 0."""
    return pack_qty if pack_qty and pack_qty > 0 else 1

def available_qty_multiplier(site, pack_qty):
    """
    CONFIRMED RULE (site-conditional): UNRESTRICTED_AVAILABLE_QTY uses the
    PACK_QTY multiplier ONLY at the warehouse (SITE 9950). At Store level
    (or any Store+AG combination), UNRESTRICTED_AVAILABLE_QTY is used RAW,
    with no multiplier. GIT_QTY and TSF_EXPECTED_QTY are NOT affected by
    this rule -- they always get the pack multiplier, at every level.
    """
    if site == WH_SITE_CODE:
        return pack_multiplier(pack_qty)
    return 1

