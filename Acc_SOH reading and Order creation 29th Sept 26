def normalize_season(raw):
    """'NOS - 27' / 'nos-27' / 'NOS 27' -> 'NOS27' (letters+digits only)."""
    return re.sub(r"[^A-Z0-9]", "", str(raw).upper())


def is_allowed_season(raw):
    return normalize_season(raw) in {normalize_season(x) for x in ALLOWED_ORDER_SEASONS}


