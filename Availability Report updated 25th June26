# FOREIGN KEY FUNCTION  — FIX #1
# OLD: Removed special chars, kept spaces, uppercased.
# PROBLEM: Spaces inside strings cause mismatches when one source has extra
#          spaces between words (e.g. "ACC  LADIES  BELT" vs "ACC LADIES BELT").
#          Also, the hyphen in "TABLE TEES-STRUCTURE" was stripped, making it
#          "TABLE TEESSTRUCTURE" which never matches "TABLE TEES STRUCTURE".
# FIX: Collapse ALL whitespace runs to a single space AFTER stripping specials,
#      then strip leading/trailing spaces.  This is backward-compatible — it
#      produces the same result for well-formed values and fixes double-space edge
#      cases automatically.
# ══════════════════════════════════════════════════════════════════════════════
def clean_key(value):
    """
    Normalise a string for use as part of a Foreign Key.
    Steps:
      1. Strip leading/trailing whitespace.
      2. Remove every character that is NOT alphanumeric or a space.
      3. Collapse multiple consecutive spaces into one.
      4. Convert to UPPERCASE.
    """
    s = str(value).strip()
    s = re.sub(r'[^a-zA-Z0-9 ]', ' ', s)   # replace specials with space (not '')
    s = re.sub(r' +', ' ', s)               # collapse runs of spaces
    return s.strip().upper()

# NOTE ON THE HYPHEN FIX:
# The original code used re.sub(r'[^a-zA-Z0-9 ]', '', ...) — removing the hyphen
# entirely.  This turned "TABLE TEES-STRUCTURE" → "TABLE TEESSTRUCTURE".
# If Sales had "TABLE TEES STRUCTURE" (with a space instead of hyphen), the keys
# would never match.  By replacing specials with a space instead of nothing, both
# sides normalise to "TABLE TEES STRUCTURE" and match correctly.

