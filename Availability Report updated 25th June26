# DIAGNOSTIC HELPER (run separately to maintain PRODUCT_CORRECTIONS)
# Copy-paste the function below into a separate script and run it whenever you
# receive new Sales_L7D / TW_P files to discover NEW unmatched PHD values.
# ══════════════════════════════════════════════════════════════════════════════
def run_diagnostic(tw_path, sales_path, corrections=None):
    """
    Print all Sales PHD values that do NOT match any TW_P Assortment Group
    after applying corrections.  Use the output to expand PRODUCT_CORRECTIONS.
    """
    import pandas as pd, re

    def ck(v):
        s = re.sub(r'[^a-zA-Z0-9 ]', ' ', str(v).strip())
        return re.sub(r' +', ' ', s).strip().upper()

    tw    = pd.read_csv(tw_path,    dtype=str, keep_default_na=False, encoding='utf-8-sig')
    sales = pd.read_csv(sales_path, dtype=str, keep_default_na=False, encoding='utf-8-sig')
    tw.columns    = tw.columns.str.strip()
    sales.columns = sales.columns.str.strip()

    if corrections:
        for old, new in corrections.items():
            sales.loc[sales["Product Hierarchy Description"]==old, "Product Hierarchy Description"] = new

    ag_clean  = set(tw["Assortment Group"].apply(ck))
    phd_clean = set(sales["Product Hierarchy Description"].apply(ck))
    unmatched = phd_clean - ag_clean

    print(f"\n{'='*60}")
    print(f"Unmatched PHD values ({len(unmatched)}) — add these to PRODUCT_CORRECTIONS:")
    print(f"{'='*60}")
    for p in sorted(unmatched):
        # find closest AG by prefix
        best = sorted(ag_clean, key=lambda a: -len(set(p.split()) & set(a.split())))[:3]
        print(f"\n  PHD:  '{p}'")
        print(f"  Near: {best}")

    tw_fks    = set(tw["Stock Location"].apply(ck) + tw["Assortment Group"].apply(ck))
    sales_fks = set(sales["Business Area"].apply(ck) + sales["Product Hierarchy Description"].apply(ck))
    matched   = tw_fks & sales_fks
    print(f"\nFK match summary: {len(matched)} / {len(sales_fks)} Sales FKs match TW_P  "
          f"({len(matched)/len(sales_fks)*100:.1f}%)")

