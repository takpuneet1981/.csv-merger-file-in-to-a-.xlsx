def find_variety_target_col(columns):
    """
    Flexible lookup for the Variety Target column in a historical LW_x file.
    Matches regardless of spacing/underscores/case, e.g. 'VarietyTarget',
    'Variety Target', 'variety_target' all resolve to the same source column.
    """
    for c in columns:
        if re.sub(r'[^a-z0-9]', '', c.lower()) == 'varietytarget':
            return c
    return None

def find_valid_families_pipe_col(columns):
    """
    Flexible lookup for the ValidFamiliesPipe column in a historical LW_x file.
    Matches regardless of spacing/underscores/case, e.g. 'ValidFamiliesPipe',
    'Valid Families Pipe', 'valid_families_pipe' all resolve to the same
    source column.
    """
    for c in columns:
        if re.sub(r'[^a-z0-9]', '', c.lower()) == 'validfamiliespipe':
            return c
    return None

