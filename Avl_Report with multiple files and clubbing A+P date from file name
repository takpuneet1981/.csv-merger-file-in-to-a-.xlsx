        df["Foreign Key"] = df["stocklocationname"].apply(clean_key) + df["AG Name"].apply(clean_key)

        dupes = df.duplicated("Foreign Key").sum()
        if dupes > 0:
            df = df.drop_duplicates("Foreign Key", keep="last")

        col_name = stem
        if col_name in used_col_names:
            col_name = f"{stem}_dup"
            print(f"        ⚠ Column name collision — using '{col_name}' instead")
        used_col_names.add(col_name)

        # Build the varietytarget_<date> column name (header format required:
        # 'varietytarget' + '_' + the date exactly as it appears in the filename)
        vt_col_name = None
        if vt_source_col:
            vt_col_name = f"varietytarget_{date_str}"
            if vt_col_name in used_col_names:
                vt_col_name = f"varietytarget_{date_str}_dup"
                print(f"        ⚠ Column name collision — using '{vt_col_name}' instead")
            used_col_names.add(vt_col_name)

        # NEW: build the validFamiliesPipe_<date> column name (header format
        # required: 'validFamiliesPipe' + '_' + the date exactly as it appears
        # in the filename)
        vfp_col_name = None
        if vfp_source_col:
            vfp_col_name = f"validFamiliesPipe_{date_str}"
            if vfp_col_name in used_col_names:
                vfp_col_name = f"validFamiliesPipe_{date_str}_dup"
                print(f"        ⚠ Column name collision — using '{vfp_col_name}' instead")
            used_col_names.add(vfp_col_name)

        keep_cols  = ["Foreign Key", "ValidFamiliesSite"]
        rename_map = {"ValidFamiliesSite": col_name}
        if vt_source_col:
            keep_cols.append(vt_source_col)
            rename_map[vt_source_col] = vt_col_name
        if vfp_source_col:
            keep_cols.append(vfp_source_col)
            rename_map[vfp_source_col] = vfp_col_name
        df = df[keep_cols].rename(columns=rename_map)

        merged_df = merged_df.merge(df, on="Foreign Key", how="left")

        matched   = merged_df[col_name].replace("", pd.NA).notna().sum()
        match_pct = (matched / len(merged_df) * 100) if len(merged_df) > 0 else 0.0

        vt_matched, vt_match_pct = 0, 0.0
        if vt_col_name:
            vt_matched   = merged_df[vt_col_name].replace("", pd.NA).notna().sum()
            vt_match_pct = (vt_matched / len(merged_df) * 100) if len(merged_df) > 0 else 0.0

        vfp_matched, vfp_match_pct = 0, 0.0
        if vfp_col_name:
            vfp_matched   = merged_df[vfp_col_name].replace("", pd.NA).notna().sum()
            vfp_match_pct = (vfp_matched / len(merged_df) * 100) if len(merged_df) > 0 else 0.0

        print(f"        ✓ rows_loaded={rows_loaded}  |  duplicate_FKs_removed={dupes}  "
              f"|  {col_name} matched={matched}/{len(merged_df)} ({match_pct:.1f}%)")
        if vt_col_name:
