# NEW: FILENAME DATE PARSER
# Extracts a real date out of the compact "09july26" style suffix in the
# filename so the new columns can be ordered oldest -> newest, independent of
# whatever number (LW_1, LW_2 ...) happens to be in the filename.
# ══════════════════════════════════════════════════════════════════════════════
MONTH_LOOKUP = {}
for _i in range(1, 13):
    MONTH_LOOKUP[calendar.month_abbr[_i].lower()] = _i   # jan, feb, mar...
    MONTH_LOOKUP[calendar.month_name[_i].lower()] = _i   # january, february...

def parse_date_from_filename(date_str):
    """
    Parse a compact date fragment like '09july26', '9Jul2026', '15Aug26' into
    a datetime.date. Returns None if it cannot be confidently parsed (the file
    is still processed and merged — it's just sorted to the end with a warning).
    """
    s = date_str.strip()
    m = re.match(r'^(\d{1,2})([A-Za-z]+)(\d{2,4})$', s)
    if not m:
        return None
    day_str, month_str, year_str = m.groups()
    month_str = month_str.lower()
    month_num = MONTH_LOOKUP.get(month_str) or MONTH_LOOKUP.get(month_str[:3])
    if month_num is None:
        return None
    try:
        day = int(day_str)
        year = int(year_str)
        if year < 100:
            year += 2000
        return date(year, month_num, day)
    except Exception:
        return None

