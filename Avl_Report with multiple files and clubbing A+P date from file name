        if vfp_col_name:
            print(f"        ✓ {vfp_col_name} matched={vfp_matched}/{len(merged_df)} ({vfp_match_pct:.1f}%)")

        new_columns_order.append(col_name)
        if vt_col_name:
            variety_columns_order.append(vt_col_name)
        if vfp_col_name:
            pipe_columns_order.append(vfp_col_name)

        file_stats.append({"file": fname, "status": "SUCCESS", "reason": "",
                            "rows_loaded": rows_loaded, "matched": int(matched), "match_pct": match_pct,
                            "vt_found": vt_source_col is not None,
                            "vt_matched": int(vt_matched), "vt_match_pct": vt_match_pct,
                            "vfp_found": vfp_source_col is not None,
                            "vfp_matched": int(vfp_matched), "vfp_match_pct": vfp_match_pct})

